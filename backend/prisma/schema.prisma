model CameraTransition {
  id                  String   @id @default(cuid())
  sourceCameraId      String
  destinationCameraId String
  vehicleId           String
  timestamp           DateTime
  travelTimeSeconds   Int?
  distanceMeters      Float?
  averageSpeed        Float?
  createdAt           DateTime @default(now())

  sourceCamera      Camera  @relation("SourceCamera", fields: [sourceCameraId], references: [id])
  destinationCamera Camera  @relation("DestinationCamera", fields: [destinationCameraId], references: [id])
  vehicle           Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, timestamp])
  @@index([sourceCameraId, timestamp])
  @@index([destinationCameraId, timestamp])
}

model Trajectory {
  id             String   @id @default(cuid())
  vehicleId      String
  startTime      DateTime
  endTime        DateTime
  startCameraId  String
  endCameraId    String
  distanceMeters Float?
  averageSpeed   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])
  startCamera Camera  @relation("StartCamera", fields: [startCameraId], references: [id])
  endCamera   Camera  @relation("EndCamera", fields: [endCameraId], references: [id])

  @@index([vehicleId, startTime])
  @@index([startCameraId, startTime])
  @@index([endCameraId, endTime])
}

model Prediction {
  id                String   @id @default(cuid())
  vehicleId         String
  currentCameraId   String
  predictedCameraId String
  probability       Float
  predictionTime    DateTime @default(now())
  createdAt         DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  currentCamera Camera @relation("CurrentCameraPrediction", fields: [currentCameraId], references: [id])

  predictedCamera Camera @relation("PredictedCamera", fields: [predictedCameraId], references: [id])

  @@index([vehicleId, predictionTime])
}

enum AnomalyType {
  ROUTE_ANOMALY
  UNUSUAL_TRAVEL_TIME
  UNUSUAL_CAMERA_TRANSITION
}

enum BlacklistSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlacklistStatus {
  ACTIVE
  INACTIVE
}

model AnomalyEvent {
  id            String      @id @default(cuid())
  vehicleId     String
  cameraId      String
  type          AnomalyType
  score         Float?
  expectedRoute Json?
  observedRoute Json?
  timestamp     DateTime
  createdAt     DateTime    @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  camera  Camera  @relation(fields: [cameraId], references: [id])
  alerts  Alert[]
}

enum AlertType {
  BLACKLIST_MATCH
  ROUTE_ANOMALY
  CONGESTION
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id             String        @id @default(cuid())
  type           AlertType
  severity       AlertSeverity
  vehicleId      String?
  cameraId       String?
  anomalyEventId String?
  message        String
  status         AlertStatus   @default(ACTIVE)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  camera       Camera?       @relation(fields: [cameraId], references: [id])
  anomalyEvent AnomalyEvent? @relation(fields: [anomalyEventId], references: [id])
}

model BlacklistedVehicle {
  id          String            @id @default(cuid())
  plateNumber String            @unique
  reason      String
  severity    BlacklistSeverity
  status      BlacklistStatus   @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  detections      Detection[]
  blacklistAlerts BlacklistAlert[]

  @@index([plateNumber, status])
}

model TrafficAggregate {
  id             String   @id @default(cuid())
  cameraId       String
  zoneId         String?
  timeBucket     DateTime
  vehicleCount   Int      @default(0)
  averageSpeed   Float?
  trafficDensity Float?
  createdAt      DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id])
  zone   Zone?  @relation(fields: [zoneId], references: [id])

  @@index([cameraId, timeBucket])
  @@index([zoneId, timeBucket])
}

enum TrafficEventType {
  ACCIDENT
  ROAD_BLOCK
  CONGESTION
  VEHICLE_BREAKDOWN
}

enum TrafficEventStatus {
  ACTIVE
  RESOLVED
}

model CameraHealth {
  id           String       @id @default(cuid())
  cameraId     String
  status       CameraStatus
  recordedAt   DateTime     @default(now())
  responseMs   Int?
  errorMessage String?

  camera Camera @relation(fields: [cameraId], references: [id])

  @@index([cameraId, recordedAt])
}

model TrafficEvent {
  id       String           @id @default(cuid())
  type     TrafficEventType
  severity AlertSeverity

  cameraId String?
  roadId   String?
  zoneId   String?

  latitude  Float?
  longitude Float?

  description String?
  status      TrafficEventStatus @default(ACTIVE)

  startedAt  DateTime
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  camera Camera? @relation(fields: [cameraId], references: [id])
  road   Road?   @relation(fields: [roadId], references: [id])
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  @@index([cameraId, startedAt])
  @@index([roadId, startedAt])
  @@index([zoneId, startedAt])
  @@index([status])
}

model SystemMetric {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  activeCameras   Int @default(0)
  activeVehicles  Int @default(0)
  totalDetections Int @default(0)
  activeAlerts    Int @default(0)

  averageSpeed   Float?
  trafficDensity Float?
}

enum BlacklistAlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

model BlacklistAlert {
  id               String               @id @default(cuid())
  detectionEventId String
  blacklistId      String
  cameraId         String
  vehicleId        String
  plateNumber      String
  timestamp        DateTime
  status           BlacklistAlertStatus @default(NEW)
  createdAt        DateTime             @default(now())

  detectionEvent Detection          @relation(fields: [detectionEventId], references: [id])
  blacklist      BlacklistedVehicle @relation(fields: [blacklistId], references: [id])

  @@index([plateNumber, timestamp])
  @@index([cameraId, timestamp])
  @@index([blacklistId])
}

enum VehicleIncidentType {
  CRASH
  BREAKDOWN
  TRAFFIC_VIOLATION
  OTHER
}

enum VehicleIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VehicleIncidentStatus {
  OPEN
  RESOLVED
}

model VehicleIncident {
  id          String   @id @default(cuid())
  vehicleId   String
  cameraId    String?
  type        VehicleIncidentType
  severity    VehicleIncidentSeverity @default(MEDIUM)
  status      VehicleIncidentStatus @default(OPEN)
  description String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  camera  Camera? @relation(fields: [cameraId], references: [id])

  @@index([vehicleId, timestamp])
}
