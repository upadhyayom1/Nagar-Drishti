generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  detections         Detection[]
  cameraTransitions  CameraTransition[]
  trajectories       Trajectory[]
  predictions        Prediction[]
  anomalyEvents      AnomalyEvent[]
  alerts             Alert[]
}

enum CameraStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model Camera {
  id         String       @id @default(cuid())
  cameraCode String       @unique
  name       String
  latitude   Float
  longitude  Float
  direction  String?
  zone       String?
  status     CameraStatus @default(ONLINE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  detections                    Detection[]
  sourceCameraTransitions       CameraTransition[] @relation("SourceCamera")
  destinationCameraTransitions  CameraTransition[] @relation("DestinationCamera")
  startTrajectories             Trajectory[]       @relation("StartCamera")
  endTrajectories               Trajectory[]       @relation("EndCamera")
  predictions                   Prediction[]
  anomalyEvents                 AnomalyEvent[]
  alerts                        Alert[]
  trafficAggregates             TrafficAggregate[]
}

model Detection {
  id                String   @id @default(cuid())
  vehicleId         String
  cameraId          String
  plateText         String
  ocrConfidence     Float?
  vehicleConfidence Float?
  timestamp         DateTime
  latitude          Float?
  longitude         Float?
  direction         String?
  lane              Int?
  imageUrl          String?
  createdAt         DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  camera  Camera  @relation(fields: [cameraId], references: [id])

  @@index([vehicleId, timestamp])
  @@index([cameraId, timestamp])
  @@index([plateText])
  @@index([timestamp])
}

model CameraTransition {
  id                  String   @id @default(cuid())
  sourceCameraId      String
  destinationCameraId String
  vehicleId           String
  timestamp           DateTime
  travelTimeSeconds   Int?
  distanceMeters      Float?
  averageSpeed        Float?
  createdAt           DateTime @default(now())

  sourceCamera      Camera  @relation("SourceCamera", fields: [sourceCameraId], references: [id])
  destinationCamera Camera  @relation("DestinationCamera", fields: [destinationCameraId], references: [id])
  vehicle           Vehicle @relation(fields: [vehicleId], references: [id])
}

model Trajectory {
  id             String   @id @default(cuid())
  vehicleId      String
  startTime      DateTime
  endTime        DateTime
  startCameraId  String
  endCameraId    String
  distanceMeters Float?
  averageSpeed   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])
  startCamera Camera  @relation("StartCamera", fields: [startCameraId], references: [id])
  endCamera   Camera  @relation("EndCamera", fields: [endCameraId], references: [id])
}

model Prediction {
  id                String   @id @default(cuid())
  vehicleId         String
  currentCameraId   String
  predictedCameraId String
  probability       Float
  createdAt         DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  camera  Camera  @relation(fields: [currentCameraId], references: [id])
}

enum AnomalyType {
  ROUTE_ANOMALY
  UNUSUAL_TRAVEL_TIME
  UNUSUAL_CAMERA_TRANSITION
}

model AnomalyEvent {
  id            String      @id @default(cuid())
  vehicleId     String
  cameraId      String
  type          AnomalyType
  score         Float?
  expectedRoute Json?
  observedRoute Json?
  timestamp     DateTime
  createdAt     DateTime    @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  camera  Camera  @relation(fields: [cameraId], references: [id])
  alerts  Alert[]
}

enum AlertType {
  BLACKLIST_MATCH
  ROUTE_ANOMALY
  CONGESTION
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id             String        @id @default(cuid())
  type           AlertType
  severity       AlertSeverity
  vehicleId      String?
  cameraId       String?
  anomalyEventId String?
  message        String
  status         AlertStatus   @default(ACTIVE)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  camera       Camera?       @relation(fields: [cameraId], references: [id])
  anomalyEvent AnomalyEvent? @relation(fields: [anomalyEventId], references: [id])
}

model BlacklistedVehicle {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  reason      String
  severity    String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plateNumber])
}

model TrafficAggregate {
  id             String   @id @default(cuid())
  cameraId       String
  zone           String?
  timeBucket     DateTime
  vehicleCount   Int      @default(0)
  averageSpeed   Float?
  trafficDensity Float?
  createdAt      DateTime @default(now())

  camera Camera @relation(fields: [cameraId], references: [id])

  @@index([cameraId, timeBucket])
}
